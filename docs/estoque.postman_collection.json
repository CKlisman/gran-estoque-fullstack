{
  "info": {
    "name": "Gran — Estoque",
    "description": "Dados fictícios. Criar entidades antes de associar; exclusões são opcionais e definitivas no banco local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4316/api"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "supplierId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Saúde",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Criar produto fictício",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teclado USB compacto\",\n  \"barcode\": \"7890000000011\",\n  \"description\": \"Teclado com conexão USB, layout ABNT2. Cadastro demonstrativo.\",\n  \"category\": \"Eletrônicos\",\n  \"quantity\": 24,\n  \"price\": \"89.90\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('productId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
