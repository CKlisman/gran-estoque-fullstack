{
  "name": "gran-estoque-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Projeto Integrador Gran — produtos, fornecedores e associações",
  "author": "Caio Klisman",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node backend/app.js",
    "dev": "concurrently -k \"node --watch backend/app.js\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "test": "node --test backend/test/*.test.js",
    "test:e2e": "playwright test",
    "seed": "node backend/seed.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4"
  }
}
